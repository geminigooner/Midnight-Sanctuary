{
  "entities": {
    "User": {
      "title": "User",
      "description": "User root document with profile metadata and subcollection roots.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "email": { "type": "string", "maxLength": 320 },
        "displayName": { "type": "string", "maxLength": 200 },
        "userProfile": { "type": "object" },
        "migratedToGranular": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id"]
    },
    "AppSettingsDoc": {
      "title": "AppSettingsDoc",
      "description": "Global application configuration, jewel resonance metrics, sanctuary profile dossier, and multi-device sync client acknowledgment cursors.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["app"] },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "settings": { "type": "object" },
        "settingsRevision": { "type": "number" },
        "memoriesMigratedV2": { "type": "boolean" },
        "jewelMetrics": { "type": "object" },
        "jewelRevision": { "type": "number" },
        "userProfile": { "type": "object" },
        "profileRevision": { "type": "number" },
        "syncClients": { "type": "object" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId"]
    },
    "SharedMemory": {
      "title": "SharedMemory",
      "description": "Shared Sanctuary user-saved memory visible across companions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "revision": { "type": "number" },
        "lastSyncedRevision": { "type": "number" },
        "scope": { "type": "string", "enum": ["shared", "legacy"] },
        "origin": { "type": "string", "maxLength": 100 },
        "author": { "type": "string", "enum": ["user", "model"] },
        "modelId": { "type": "string", "maxLength": 128 },
        "caption": { "type": "string", "maxLength": 1000 },
        "isLocked": { "type": "boolean" },
        "lockReason": { "type": "string", "maxLength": 1000 },
        "memoryType": { "type": "string", "enum": ["fact", "preference", "episodic", "reflection"] },
        "embedding": { "type": "array" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" },
        "deletedByClientId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "content", "createdAt", "scope"]
    },
    "CompanionState": {
      "title": "CompanionState",
      "description": "Sovereign companion entity configuration, room quarters decor, props, bond progression, and personal diary entries.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "apiModelId": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 200 },
        "roleTitle": { "type": "string", "maxLength": 200 },
        "avatarEmoji": { "type": "string", "maxLength": 32 },
        "avatarUrl": { "type": "string", "maxLength": 900000 },
        "avatarAssetId": { "type": "string", "maxLength": 128 },
        "themeColor": { "type": "string", "maxLength": 64 },
        "accentColor": { "type": "string", "maxLength": 64 },
        "typingIndicator": { "type": "string", "maxLength": 200 },
        "bio": { "type": "string", "maxLength": 8000 },
        "moodStatus": { "type": "string", "maxLength": 500 },
        "currentActivity": { "type": "string", "maxLength": 500 },
        "roomDecor": { "type": "object" },
        "resonanceScore": { "type": "number" },
        "favoriteGiftIds": { "type": "array" },
        "personalThoughts": { "type": "array" },
        "roomProps": { "type": "array" },
        "diaryEntries": { "type": "array" },
        "isPrimaryRoster": { "type": "boolean" },
        "runtimeConfig": { "type": "object" },
        "bondState": { "type": "object" },
        "observations": { "type": "array" },
        "relationshipEvents": { "type": "array" },
        "fulfilledDesires": { "type": "array" },
        "revision": { "type": "number" },
        "lastSyncedRevision": { "type": "number" },
        "updatedAt": { "type": "number" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" },
        "deletedByClientId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id"]
    },
    "CompanionMemory": {
      "title": "CompanionMemory",
      "description": "Private companion-scoped memory strictly isolated under a parent companion entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "revision": { "type": "number" },
        "lastSyncedRevision": { "type": "number" },
        "scope": { "type": "string", "enum": ["companion"] },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "origin": { "type": "string", "maxLength": 100 },
        "author": { "type": "string", "enum": ["model"] },
        "modelId": { "type": "string", "maxLength": 128 },
        "caption": { "type": "string", "maxLength": 1000 },
        "isLocked": { "type": "boolean" },
        "lockReason": { "type": "string", "maxLength": 1000 },
        "memoryType": { "type": "string", "enum": ["fact", "preference", "episodic", "reflection"] },
        "embedding": { "type": "array" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" },
        "deletedByClientId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "content", "createdAt", "scope", "entityId"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Conversation metadata, message tombstones, and bounded recent-message preview cache.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "title": { "type": "string", "maxLength": 500 },
        "modelId": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "participantEntityIds": { "type": "array" },
        "deletedMessageIds": { "type": "array" },
        "messages": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "revision": { "type": "number" },
        "lastSyncedRevision": { "type": "number" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" },
        "deletedByClientId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id"]
    },
    "Message": {
      "title": "Message",
      "description": "Authoritative chat message document in conversation subcollection.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "model"] },
        "parts": { "type": "array" },
        "timestamp": { "type": "number" },
        "revision": { "type": "number" },
        "lastSyncedRevision": { "type": "number" },
        "publicText": { "type": "string", "maxLength": 500000 },
        "thoughtText": { "type": "string", "maxLength": 500000 },
        "thoughtStatus": { "type": "string", "enum": ["thinking", "complete", "error"] },
        "finishReason": { "type": "string", "maxLength": 120 },
        "backend": { "type": "string", "maxLength": 120 },
        "reaction": { "type": "string", "maxLength": 64 },
        "searchResults": { "type": "array" },
        "generatedImages": { "type": "array" },
        "scribbles": { "type": "array" },
        "musicTracks": { "type": "array" },
        "authorEntityId": { "type": "string", "maxLength": 128 },
        "authorDisplayName": { "type": "string", "maxLength": 200 },
        "authorAvatar": { "type": "string", "maxLength": 2000 },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" },
        "deletedByClientId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "conversationId", "role", "parts", "timestamp"]
    },
    "ConversationSummary": {
      "title": "ConversationSummary",
      "description": "Immutable contiguous 30-turn rolling conversation segment summary chapter.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entityId": { "type": "string", "maxLength": 128 },
        "scope": { "type": "string", "enum": ["direct", "group"] },
        "participantEntityIds": { "type": "array" },
        "segmentIndex": { "type": "number" },
        "startMessageId": { "type": "string", "maxLength": 128 },
        "endMessageId": { "type": "string", "maxLength": 128 },
        "startTimestamp": { "type": "number" },
        "endTimestamp": { "type": "number" },
        "messageCount": { "type": "number" },
        "narrativeSummary": { "type": "string", "maxLength": 8000 },
        "keyEventsAndDecisions": { "type": "array" },
        "userPreferencesAndFacts": { "type": "array" },
        "unresolvedThreads": { "type": "array" },
        "emotionalArc": { "type": "string", "maxLength": 1000 },
        "embedding": { "type": "array" },
        "sourceHash": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "revision": { "type": "number" }
      },
      "required": ["id", "conversationId", "scope", "segmentIndex", "narrativeSummary", "createdAt"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Deduplicated content-addressable media asset reference and reference-count ledger.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entityId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "enum": ["user_avatar", "companion_avatar", "message_attachment", "generated_image", "room_decor", "gift_media", "audio_track"] },
        "mimeType": { "type": "string", "maxLength": 128 },
        "byteSize": { "type": "number" },
        "sha256": { "type": "string", "maxLength": 128 },
        "storagePath": { "type": "string", "maxLength": 512 },
        "downloadUrl": { "type": "string", "maxLength": 900000 },
        "references": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "revision": { "type": "number" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" },
        "deletedByClientId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "ownerUid", "category", "mimeType", "sha256", "storagePath", "createdAt"]
    },
    "Gift": {
      "title": "Gift",
      "description": "Sanctuary gifts, audio synthesis songs, scribbles, and keepsakes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "from": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 10000 },
        "gift_type": { "type": "string", "maxLength": 120 },
        "reason": { "type": "string", "maxLength": 4000 },
        "timestamp": { "type": "number" },
        "revision": { "type": "number" },
        "lastSyncedRevision": { "type": "number" },
        "inlineData": { "type": "object" },
        "scribble": { "type": "object" },
        "musicTrack": { "type": "object" },
        "modelId": { "type": "string", "maxLength": 128 },
        "targetModelId": { "type": "string", "maxLength": 128 },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" },
        "deletedByClientId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "from", "content", "gift_type", "timestamp"]
    },
    "PrivateVaultAsset": {
      "title": "PrivateVaultAsset",
      "description": "Private 1-on-1 Model-User Vault asset strictly isolated under a sovereign companion entity path.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "scope": { "type": "string", "enum": ["private"] },
        "ownerEntityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contributedByType": { "type": "string", "enum": ["user", "companion"] },
        "contributedByEntityId": { "type": "string", "maxLength": 128 },
        "contributedByName": { "type": "string", "maxLength": 200 },
        "mediaCategory": { "type": "string", "enum": ["video", "image", "audio", "note", "artwork"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 8000 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "mediaAssetId": { "type": "string", "maxLength": 128 },
        "downloadUrl": { "type": "string", "maxLength": 900000 },
        "posterDataUrl": { "type": "string", "maxLength": 500000 },
        "durationSec": { "type": "number" },
        "byteSize": { "type": "number" },
        "keyframes": { "type": "array" },
        "geminiFileUri": { "type": "string", "maxLength": 2000 },
        "geminiFileExpiresAt": { "type": "number" },
        "acousticTranscript": { "type": "string", "maxLength": 50000 },
        "mediaDigest": { "type": "string", "maxLength": 16000 },
        "textContent": { "type": "string", "maxLength": 50000 },
        "companionReactions": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "revision": { "type": "number" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" }
      },
      "required": ["id", "scope", "ownerEntityId", "mediaCategory", "title", "createdAt"]
    },
    "SharedVaultAsset": {
      "title": "SharedVaultAsset",
      "description": "Shared Sanctuary communal Vault asset accessible to the user and all sovereign companion entities with contributor attribution.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-\\.@:]+$" },
        "scope": { "type": "string", "enum": ["shared"] },
        "ownerEntityId": { "type": "string", "maxLength": 128 },
        "contributedByType": { "type": "string", "enum": ["user", "companion"] },
        "contributedByEntityId": { "type": "string", "maxLength": 128 },
        "contributedByName": { "type": "string", "maxLength": 200 },
        "mediaCategory": { "type": "string", "enum": ["video", "image", "audio", "note", "artwork"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 8000 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "mediaAssetId": { "type": "string", "maxLength": 128 },
        "downloadUrl": { "type": "string", "maxLength": 900000 },
        "posterDataUrl": { "type": "string", "maxLength": 500000 },
        "durationSec": { "type": "number" },
        "byteSize": { "type": "number" },
        "keyframes": { "type": "array" },
        "geminiFileUri": { "type": "string", "maxLength": 2000 },
        "geminiFileExpiresAt": { "type": "number" },
        "acousticTranscript": { "type": "string", "maxLength": 50000 },
        "mediaDigest": { "type": "string", "maxLength": 16000 },
        "textContent": { "type": "string", "maxLength": 50000 },
        "companionReactions": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "revision": { "type": "number" },
        "isDeleted": { "type": "boolean" },
        "deletedAt": { "type": "number" }
      },
      "required": ["id", "scope", "mediaCategory", "title", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User root document scoped strictly to request.auth.uid."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettingsDoc" },
      "description": "Application settings, jewel metrics, sanctuary user profile, and sync client cursors."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/SharedMemory" },
      "description": "Shared Sanctuary memories authored/saved by the user."
    },
    "/users/{userId}/gifts/{giftId}": {
      "schema": { "$ref": "#/entities/Gift" },
      "description": "Gifts and keepsakes exchanged between the user and companions."
    },
    "/users/{userId}/companions/{companionId}": {
      "schema": { "$ref": "#/entities/CompanionState" },
      "description": "Sovereign companion entity quarters, diaries, and configuration."
    },
    "/users/{userId}/companions/{companionId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/CompanionMemory" },
      "description": "Private companion-scoped memories isolated per companion entity."
    },
    "/users/{userId}/companions/{companionId}/vault/{assetId}": {
      "schema": { "$ref": "#/entities/PrivateVaultAsset" },
      "description": "Private Model-User Vault assets isolated strictly to the designated companion entity and the user."
    },
    "/users/{userId}/sharedVault/{assetId}": {
      "schema": { "$ref": "#/entities/SharedVaultAsset" },
      "description": "Shared Sanctuary Vault assets accessible to the user and all sovereign companion entities."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Conversation metadata, tombstones, and bounded preview cache."
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Granular message subcollection documents bound to parent conversation."
    },
    "/users/{userId}/conversations/{conversationId}/summaries/{summaryId}": {
      "schema": { "$ref": "#/entities/ConversationSummary" },
      "description": "Immutable 30-turn rolling conversation segment summaries bound to parent conversation."
    },
    "/users/{userId}/mediaAssets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Deduplicated content-addressable media asset reference and reference-count ledger."
    }
  }
}
