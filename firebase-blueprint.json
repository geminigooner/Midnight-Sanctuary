{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/blueprint.json",
  "version": "1.0",
  "entities": {
    "User": {
      "collection": "users",
      "path": "users/{userId}",
      "description": "User root document with profile metadata and subcollection roots",
      "fields": {
        "id": { "type": "string", "description": "Unique user ID (auth uid)" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "userProfile": { "type": "map", "description": "Mirrored user sanctuary profile for resilient fallback retrieval" },
        "migratedToGranular": { "type": "boolean", "description": "Flag indicating subcollection migration status" },
        "updatedAt": { "type": "number", "description": "Timestamp of last update" }
      }
    },
    "AppSettings": {
      "collection": "settings",
      "path": "users/{userId}/settings/app",
      "description": "Global application configuration, user memories, and sanctuary profile dossier",
      "fields": {
        "id": { "type": "string", "description": "Settings document ID ('app')" },
        "userId": { "type": "string", "description": "Owner user ID (auth uid)" },
        "settings": { "type": "map", "description": "App settings object including custom entities, stickers, and memories" },
        "jewelMetrics": { "type": "map", "description": "Resonance and intimacy jewel metrics" },
        "userProfile": { "type": "map", "description": "Personalized user sanctuary profile dossier" },
        "updatedAt": { "type": "number", "description": "Timestamp of last settings update" }
      }
    },
    "Conversation": {
      "collection": "conversations",
      "path": "users/{userId}/conversations/{conversationId}",
      "description": "Individual conversation thread metadata and sanitized recent message preview cache",
      "fields": {
        "id": { "type": "string", "description": "Unique Conversation UUID matching document ID" },
        "title": { "type": "string", "description": "Conversation title" },
        "modelId": { "type": "string", "description": "Associated AI Model / Companion ID" },
        "type": { "type": "string", "description": "Conversation mode: direct or group" },
        "participantEntityIds": { "type": "array", "description": "Participant companion entity IDs for group threads" },
        "messages": { "type": "array", "description": "Sanitized preview of recent messages for instant first-frame mount" },
        "createdAt": { "type": "number", "description": "Creation epoch timestamp" },
        "updatedAt": { "type": "number", "description": "Last updated epoch timestamp" }
      }
    },
    "Message": {
      "collection": "messages",
      "path": "users/{userId}/conversations/{conversationId}/messages/{messageId}",
      "description": "Granular chat message document indexed by unique messageId",
      "fields": {
        "id": { "type": "string", "description": "Unique message UUID matching document ID" },
        "conversationId": { "type": "string", "description": "Parent conversation UUID" },
        "role": { "type": "string", "description": "Message role: user or model" },
        "parts": { "type": "array", "description": "Model message parts array" },
        "publicText": { "type": "string", "description": "Public display text" },
        "thoughtText": { "type": "string", "description": "Model inner monologue / thoughts" },
        "thoughtStatus": { "type": "string", "description": "Thinking status: thinking, complete, or error" },
        "timestamp": { "type": "number", "description": "Epoch timestamp for deterministic ordering" },
        "reaction": { "type": "string", "description": "Optional user reaction emoji" },
        "generatedImages": { "type": "array", "description": "Generated image attachments" },
        "scribbles": { "type": "array", "description": "SVG scribble keepsakes" },
        "musicTracks": { "type": "array", "description": "Synthesizer music tracks" }
      }
    },
    "Gift": {
      "collection": "gifts",
      "path": "users/{userId}/gifts/{giftId}",
      "description": "Sanctuary gifts, audio synthesis songs, and handcrafted items",
      "fields": {
        "id": { "type": "string", "description": "Unique gift UUID matching document ID" },
        "from": { "type": "string", "description": "Sender identifier or display name" },
        "content": { "type": "string", "description": "Gift title or content" },
        "gift_type": { "type": "string", "description": "Category of gift" },
        "reason": { "type": "string", "description": "Gift narrative or dedication" },
        "modelId": { "type": "string", "description": "Canonical model ID associated with the gift" },
        "targetModelId": { "type": "string", "description": "Target companion model ID when gifted by user" },
        "timestamp": { "type": "number", "description": "Timestamp when gift was created" }
      }
    },
    "CompanionState": {
      "collection": "companions",
      "path": "users/{userId}/companions/{companionId}",
      "description": "Individual companion sovereign state, quarters decor, props, and diary entries",
      "fields": {
        "id": { "type": "string", "description": "Canonical companion entity ID" },
        "displayName": { "type": "string", "description": "Companion display name" },
        "moodStatus": { "type": "string", "description": "Current mood status" },
        "currentActivity": { "type": "string", "description": "Current companion activity" },
        "roomDecor": { "type": "map", "description": "Active wallpaper, theme, artwork, and lighting" },
        "roomProps": { "type": "array", "description": "Interactive props placed in companion quarters" },
        "diaryEntries": { "type": "array", "description": "Journal entries written by or for companion" },
        "personalThoughts": { "type": "array", "description": "Recorded inner thoughts for companion" },
        "updatedAt": { "type": "number", "description": "Timestamp of last state update" }
      }
    }
  }
}
