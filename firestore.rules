rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'ahatley094@gmail.com');
    }

    // User root document and all nested granular subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Fallback for any other root documents
    match /{document=**} {
      allow read, write: if request.auth != null && (request.auth.token.email == 'ahatley094@gmail.com' || request.auth.uid != null);
    }
  }
}
